{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/alpha", "destination": "/alpha.html" },
    { "source": "/me", "destination": "/me.html" },
    { "source": "/connect", "destination": "/connect.html" },
    { "source": "/links", "destination": "/links.html" },
    { "source": "/prompts", "destination": "https://promptsethi.com" },
    { "source": "/prompts/:path*", "destination": "https://promptsethi.com/:path*" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" }
  ]
}
